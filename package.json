{
  "name": "@gchmis/esm-ui-customizations-app",
  "version": "9.0.2",
  "license": "MPL-2.0",
  "description": "Additive GCHMIS UI customizations for the OpenMRS SPA",
  "browser": "dist/gchmis-esm-ui-customizations-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "start:local": "openmrs develop --backend http://localhost --port 9000 --open false",
    "start:customizations-only": "openmrs develop --backend http://localhost --port 9000 --open false --importmap '{\"imports\":{}}' --routes '{}'",
    "install:docker-customizations": "./scripts/install-local-docker-customizations.sh",
    "serve": "webpack serve --mode=development",
    "debug": "npm run serve",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "build": "webpack --mode=production",
    "build:development": "webpack --mode=development",
    "analyze": "webpack --mode=production --env analyze=true",
    "typescript": "tsc",
    "lint": "eslint src --ext ts,tsx",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/**/*.extension.tsx' 'src/**/*.modal.tsx' 'src/**/*.resource.ts'",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests"
  },
  "keywords": [
    "openmrs",
    "microfrontends",
    "gchmis"
  ],
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gchmis/gchmis-openmrs-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/gchmis/gchmis-openmrs-frontend/issues"
  },
  "homepage": "https://github.com/gchmis/gchmis-openmrs-frontend#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@carbon/react": "1.x",
    "@hookform/resolvers": "^3.6.0",
    "@react-aria/utils": "^3.31.0",
    "lodash-es": "^4.17.21",
    "react-hook-form": "^7.52.2",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@carbon/react": "1.x",
    "@openmrs/esm-framework": ">=8 <10",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": ">=11 <17",
    "react-router-dom": "6.x",
    "rxjs": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.16.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitest/coverage-v8": "^4.1.2",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-testing-library": "^7.1.1",
    "happy-dom": "^20.6.0",
    "openmrs": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^6.3.0",
    "rxjs": "^6.5.3",
    "swr": "2.2.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
